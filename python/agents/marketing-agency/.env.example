# Fill in your GCP project info and rename this file to ".env".

GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=<your_project_id>
GOOGLE_CLOUD_LOCATION=<your_project_location>
GOOGLE_CLOUD_STORAGE_BUCKET=<your-storage-bucket>  # Only required for deployment on Agent Engine

AGENT_PATH=./marketing_agency
APP_NAME=marketing-agent-app
MODEL_NAME=gemini-2.5-pro
SERVICE_NAME=adk-marketing-gemini-25-pro
